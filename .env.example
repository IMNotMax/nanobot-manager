# ============================================
# Nanobot Manager - Configuration Environment
# ============================================
# Copy this file to .env and customize the values
# All paths are from the container's perspective

# --------------------------------------------
# User Permissions (CRITICAL)
# --------------------------------------------
# The container runs with these UID/GID to match the host user permissions.
# This prevents permission issues when modifying ~/.nanobot/config.json
#
# IMPORTANT: Set these to YOUR user UID/GID:
#   Linux/Mac: id -u && id -g
#   Or: echo "PUID=$(id -u)" >> .env && echo "PGID=$(id -g)" >> .env
#
# If not set, defaults to 1000:1000

# PUID=<your_uid>
# PGID=<your_gid>

# --------------------------------------------
# Core Configuration
# --------------------------------------------

# HTTP port for the Flask web interface
# Default: 8899
HTTP_PORT=8899

# Debug mode for verbose logging
# Set to "true" to enable debug logs in container output
# Default: false
DEBUG=false

# --------------------------------------------
# Ollama API Configuration
# --------------------------------------------

# URL of the Ollama API for model listing
# This can be:
# - A local Ollama instance: http://localhost:11434 (if running on host)
# - A remote Ollama instance: http://192.168.x.x:11434
# - Docker container name: http://ollama:11434 (if in same network)
OLLAMA_URL=http://192.168.2.220:11434

# --------------------------------------------
# Docker Socket Proxy Configuration
# --------------------------------------------

# URL of the Docker Socket Proxy for container management
# This allows nanobot-manager to restart the nanobot-gateway container
DOCKER_PROXY_URL=http://socket-proxy-nbt-mngr:2375

# --------------------------------------------
# SSH Configuration (for Host execution mode)
# --------------------------------------------
# These settings are only needed if you want to use "host" execution mode
# instead of Docker mode for restarting nanobot-gateway

# SSH username for connecting to the host machine
HOST_SSH_USER=

# SSH hostname or IP address of the host machine
HOST_SSH_HOST=

# SSH port (default: 22)
HOST_SSH_PORT=22

# --------------------------------------------
# Optional Configuration
# --------------------------------------------

# Note: Make sure the SSH key is properly set up:
# 1. SSH keys are stored in ~/.ssh/nanobot-manager/ on the host
# 2. Generate a key pair using the web interface (Settings tab)
# 3. Copy the PUBLIC key to the remote host: ~/.ssh/authorized_keys
# 4. Ensure correct permissions on host:
#    chown -R $PUID:$PGID ~/.ssh/nanobot-manager/
#    chmod 700 ~/.ssh/nanobot-manager/
#    chmod 600 ~/.ssh/nanobot-manager/id_ed25519
