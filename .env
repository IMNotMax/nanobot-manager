# Nanobot Manager Configuration
# Pour l'utilisateur agent_smith (UID 1001, GID 1001)

# User permissions - IMPORTANT: Set to your host user UID/GID
# Get with: id -u && id -g
PUID=1001
PGID=1001

# Config path inside the container (must match volume mount)
CONFIG_PATH=/home/nanobot/.nanobot/config.json

# Web interface port
HTTP_PORT=8899

# Ollama API URL
OLLAMA_URL=http://192.168.2.220:11434

# Docker Socket Proxy URL
DOCKER_PROXY_URL=http://socket-proxy-nbt-mngr:2375

# SSH settings for host execution mode
HOST_SSH_USER=agent_smith
HOST_SSH_HOST=192.168.2.202
HOST_SSH_PORT=22
